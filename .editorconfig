# https://editorconfig.org — matches checkstyle.xml for Java.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 120

[*.py]
max_line_length = 120

[*.{xml,yaml,yml,json}]
indent_size = 2

# Election data and expected results are fixtures: keep them byte for byte.
[{library/src/test/resources/testdata/**,*.blt,*.csv}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
